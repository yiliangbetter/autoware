{
  "name": "autoware:universe-devel-cuda",
  "build": {
    "dockerfile": "../Dockerfile",
    "args": { "BASE_IMAGE": "ghcr.io/autowarefoundation/autoware:universe-devel-cuda" }
  },
  "remoteUser": "autoware",
  "hostRequirements": {
    "gpu": true
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined",
    "--net=host",
    "--volume=/etc/localtime:/etc/localtime:ro",
    "--gpus",
    "all"
  ],
"customizations": {
  "vscode": {
    "extensions": [
      "llvm-vs-code-extensions.vscode-clangd",
      "ms-vscode.cpptools",
      "ms-iot.vscode-ros"
    ],
    "settings": {
      "clangd.path": "/usr/bin/clangd",
      "clangd.arguments": ["--background-index", "--compile-commands-dir=${workspaceFolder}"],
      "C_Cpp.intelliSenseEngine": "disabled"
    }
  }
}
}
